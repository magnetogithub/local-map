# Server-only credential used by the simulation Route Handler. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Responses API model used for alternate-history turn resolution (for example, gpt-5.4).
OPENAI_MODEL=
# Server-only development switch. Mark test actions with [DEBUG_WORLD_EFFECT]. Never enable in production.
PAX_SIMULATION_DEBUG_MODE=0
